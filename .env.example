# Copy to .env and edit. Never commit .env.
# Use a URL-safe password (letters and digits) so it can sit inside DATABASE_URL.

APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_USER=gaplens
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=gaplens

# Used when running the API outside Docker (make test, local uvicorn).
# Inside Compose this value is overridden to point at the db service.
DATABASE_URL=postgresql+asyncpg://gaplens:change-me-local-only@localhost:5432/gaplens

# JSON list of allowed browser origins.
CORS_ORIGINS=["http://localhost:5173"]

# Signs access tokens. Required, at least 32 characters; the API will not start without it.
# Generate one with: openssl rand -hex 32
JWT_SECRET=

# Added in later sprints (keep empty until then):
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
